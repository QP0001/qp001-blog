# ==========================================
# Copy this file to terraform.tfvars and fill in your values
# DO NOT commit terraform.tfvars to Git!
# ==========================================

# Your public IP with /32 (check at https://checkip.amazonaws.com/)
my_ip_cidr = "YOUR_IP/32"

# EC2 KeyPair name (create in AWS Console > EC2 > Key Pairs first)
ec2_key_name = "your-keypair-name"

# RDS master username (default: admin)
db_username = "wordpress_user"

# RDS master password (8+ chars)
db_password = "YourSecurePassword123!"

# Email for budget alerts and Let's Encrypt certbot notifications
alert_email = "your-email@example.com"

# Optional: t3.micro is Free Tier eligible (recommended)
#          t4g.nano is cheaper but NOT Free Tier eligible
# instance_type = "t3.micro"
